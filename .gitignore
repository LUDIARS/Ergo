build/
build_*/

# tools/ergo — per-developer local state
tools/ergo/placer-data.json
tools/ergo/dist/
tools/ergo/node_modules/
tools/ergo/ergo-out.txt
tools/ergo/ergo-err.txt

# Cygwin/MSYS bash crash dumps
bash.exe.stackdump

# session logs (lictor 等のローカルセッションログ)
logs/

# デバッグ用メッシュエクスポート
*.obj

# Anatomia のローカル状態 (ドメイン定義の正本は spec/domains/)
# layers.json だけは解析キャッシュではなくリポジトリが持つ層宣言なので追跡する。
# ディレクトリごと除外 (`.anatomia/`) すると中のファイルを `!` で再包含できないため
# `.anatomia/*` の形にしてある。
.anatomia/*
!.anatomia/layers.json
