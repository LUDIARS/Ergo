# resolved.json determinism: same facts -> same bytes, input order does not
# matter, file(CONFIGURE) does not rewrite equal content, the output is valid
# JSON, and the File API query lands at the documented path.
include("${CMAKE_CURRENT_LIST_DIR}/pkg_test_support.cmake")

file(REMOVE_RECURSE "${ERGO_TEST_WORK_DIR}")
file(MAKE_DIRECTORY "${ERGO_TEST_WORK_DIR}")

macro(set_facts order)
    set(r_MODE M0)
    set(r_STRICT OFF)
    set(r_PLATFORM desktop)
    set(r_CMAKE_VERSION 3.20.0)
    set(r_MANIFEST ergo-packages.json)
    set(r_SELECTED "")
    set(r_PKG_pictor_KIND link)
    set(r_PKG_pictor_CODE Pc)
    set(r_PKG_pictor_PIN 625d83d61c90c30ceed3fab2bd2e11a7edf8d39f)
    set(r_PKG_pictor_EXPECT_TAG v2.2.0)
    set(r_PKG_pictor_STATE host-unmanaged)
    set(r_PKG_pictor_SOURCE_DIR "/opt/src/Pictor with space/\"quoted\"@at")
    set(r_PKG_pictor_TARGETS_PRESENT pictor)
    set(r_PKG_tela_KIND link)
    set(r_PKG_tela_CODE Tl)
    set(r_PKG_tela_STATE absent)
    set(r_PKG_lapilli_KIND tool)
    set(r_PKG_lapilli_PATH lib/lapilli)
    set(r_PKG_lapilli_GITLINK 98ed6a213c31304c3a2283a7075a0221f0a734e8)
    set(r_PKG_lapilli_INITIALIZED TRUE)
    set(r_MOD_ergo_render_ENABLED TRUE)
    set(r_MOD_ergo_render_NEEDS pictor)
    set(r_MOD_ergo_render_REASON "pictor built without PICTOR_HAS_VULKAN")
    set(r_MOD_ergo_resource_PORTED_FROM clio)
    set(r_OBS_curare_CODE Cu)
    set(r_OBS_curare_RELATIONS ergo_resource:shares-vocabulary)
    if(${order} STREQUAL "forward")
        set(r_PACKAGES lapilli pictor tela)
        set(r_MODULES ergo_render ergo_resource)
        set(r_OBSERVE clio curare)
        set(r_PKG_pictor_FEATURES vulkan web)
        set(r_FINDINGS "PKG-14|record|ergo_render|x" "PKG-06|warning|pictor|y")
    else()
        set(r_PACKAGES tela pictor lapilli)
        set(r_MODULES ergo_resource ergo_render)
        set(r_OBSERVE curare clio)
        set(r_PKG_pictor_FEATURES web vulkan)
        set(r_FINDINGS "PKG-06|warning|pictor|y" "PKG-14|record|ergo_render|x")
    endif()
endmacro()

set_facts(forward)
ergo_pkg_report_render(json_a r)
ergo_pkg_report_render(json_a2 r)
pkg_assert_eq("same facts same text" "${json_a}" "${json_a2}")
set_facts(reverse)
ergo_pkg_report_render(json_b r)
pkg_assert_eq("input order independent" "${json_a}" "${json_b}")

# Valid JSON with the expected content.
string(JSON v GET "${json_a}" mode)
pkg_assert_eq("json mode" "${v}" "M0")
string(JSON v GET "${json_a}" packages pictor state)
pkg_assert_eq("json pictor state" "${v}" "host-unmanaged")
string(JSON v GET "${json_a}" packages pictor source_dir)
pkg_assert_eq("json escaping" "${v}" "/opt/src/Pictor with space/\"quoted\"@at")
string(JSON v GET "${json_a}" packages lapilli gitlink)
pkg_assert_eq("json lapilli gitlink" "${v}" "98ed6a213c31304c3a2283a7075a0221f0a734e8")
string(JSON v TYPE "${json_a}" packages tela pin)
pkg_assert_eq("json null pin" "${v}" "NULL")
string(JSON v GET "${json_a}" findings 0 id)
pkg_assert_eq("json findings sorted" "${v}" "PKG-06")
string(JSON v LENGTH "${json_a}" findings)
pkg_assert_eq("json findings count" "${v}" "2")
string(JSON v GET "${json_a}" packages pictor features 1)
pkg_assert_eq("json features sorted" "${v}" "web")
if(json_a MATCHES "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T")
    pkg_fail("report must not carry time stamps")
endif()

# Byte-identical files; equal content is not rewritten.
set(out "${ERGO_TEST_WORK_DIR}/ergo-packages.resolved.json")
ergo_pkg_report_write("${out}" "${json_a}")
file(SHA256 "${out}" h1)
file(TIMESTAMP "${out}" t1 "%Y%m%d%H%M%S" UTC)
file(READ "${out}" back)
pkg_assert_eq("file holds the text verbatim" "${back}" "${json_a}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
ergo_pkg_report_write("${out}" "${json_b}")
file(SHA256 "${out}" h2)
file(TIMESTAMP "${out}" t2 "%Y%m%d%H%M%S" UTC)
pkg_assert_eq("same bytes" "${h1}" "${h2}")
pkg_assert_eq("not rewritten" "${t1}" "${t2}")

# A changed fact changes the bytes.
set(r_PKG_tela_STATE host-unmanaged)
ergo_pkg_report_render(json_c r)
if(json_c STREQUAL json_b)
    pkg_fail("changed fact must change the report")
endif()
pkg_pass("resolved.json determinism")

# File API query.
ergo_pkg_report_install_query("${ERGO_TEST_WORK_DIR}")
set(q "${ERGO_TEST_WORK_DIR}/.cmake/api/v1/query/client-ergo/query.json")
if(NOT EXISTS "${q}")
    pkg_fail("File API query missing at ${q}")
endif()
file(READ "${q}" qj)
string(JSON kind GET "${qj}" requests 0 kind)
string(JSON ver GET "${qj}" requests 0 version)
pkg_assert_eq("query kind" "${kind}" "codemodel")
pkg_assert_eq("query version" "${ver}" "2")
pkg_pass("File API query")
