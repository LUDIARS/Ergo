# W7: structure of the Unity package unity/com.ludiars.ergo.packages (spec/feature/package-manager.md §6.4 / §7 W7).
#   * package.json has the required keys (name, version 0.x, displayName, description, unity) and no dependencies
#   * every asmdef is Editor only; Core has noEngineReferences; there is no Runtime/ folder
#   * every file and folder has a .meta (a git package is immutable: Unity ignores assets without one), no orphan
#     .meta, no duplicated GUID
#   * Tests/Editor/Fixtures is a byte-identical copy of tests/package_watch/fixtures/*.json (same set of files)
#   * no absolute path in the package (§8)
# Needs neither Unity nor dotnet.
#
#   cmake -DERGO_SOURCE_DIR=<ergo> -P tests/packages/test_unity_package.cmake
if(NOT DEFINED ERGO_SOURCE_DIR)
    get_filename_component(ERGO_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
set(PKG "${ERGO_SOURCE_DIR}/unity/com.ludiars.ergo.packages")

function(fail what)
    message(FATAL_ERROR "FAIL: ${what}")
endfunction()

if(NOT IS_DIRECTORY "${PKG}")
    fail("unity/com.ludiars.ergo.packages is missing")
endif()

# --- package.json -------------------------------------------------------------------------------
file(READ "${PKG}/package.json" _pj)
foreach(_key name version displayName description unity)
    string(JSON _v ERROR_VARIABLE _err GET "${_pj}" ${_key})
    if(_err OR _v STREQUAL "")
        fail("package.json: '${_key}' is required")
    endif()
endforeach()
string(JSON _name GET "${_pj}" name)
if(NOT _name STREQUAL "com.ludiars.ergo.packages")
    fail("package.json: name is '${_name}'")
endif()
string(JSON _version GET "${_pj}" version)
if(NOT _version MATCHES "^0\\.[0-9]+\\.[0-9]+$")
    fail("package.json: version '${_version}' is not 0.x.y (independent of the Ergo tags)")
endif()
string(JSON _deps ERROR_VARIABLE _err LENGTH "${_pj}" dependencies)
if(NOT _err AND NOT _deps EQUAL 0)
    fail("package.json: the package has no dependencies (Core reads JSON itself)")
endif()
message(STATUS "PASS: package.json")

# --- asmdef / Runtime ---------------------------------------------------------------------------
if(EXISTS "${PKG}/Runtime")
    fail("Runtime/ must not exist (the package is Editor only)")
endif()
file(GLOB_RECURSE _asmdefs "${PKG}/*.asmdef")
list(LENGTH _asmdefs _n)
if(_n LESS 3)
    fail("expected the Core, Editor and Tests asmdefs, found ${_n}")
endif()
foreach(_a IN LISTS _asmdefs)
    file(READ "${_a}" _j)
    string(JSON _count LENGTH "${_j}" includePlatforms)
    string(JSON _p0 ERROR_VARIABLE _err GET "${_j}" includePlatforms 0)
    if(NOT _count EQUAL 1 OR NOT _p0 STREQUAL "Editor")
        fail("${_a}: includePlatforms must be [\"Editor\"]")
    endif()
endforeach()
file(READ "${PKG}/Editor/Core/Ergo.Packages.Core.asmdef" _core)
string(JSON _ner GET "${_core}" noEngineReferences)
if(NOT _ner)
    fail("Ergo.Packages.Core.asmdef: noEngineReferences must be true")
endif()
message(STATUS "PASS: asmdefs are Editor only")

# --- .meta --------------------------------------------------------------------------------------
file(GLOB_RECURSE _all LIST_DIRECTORIES true RELATIVE "${PKG}" "${PKG}/*")
set(_guids "")
foreach(_rel IN LISTS _all)
    if(_rel MATCHES "\\.meta$")
        string(REGEX REPLACE "\\.meta$" "" _target "${_rel}")
        if(NOT EXISTS "${PKG}/${_target}")
            fail("orphan meta: ${_rel}")
        endif()
        file(STRINGS "${PKG}/${_rel}" _g REGEX "^guid: [0-9a-f]+$")
        if(_g STREQUAL "")
            fail("${_rel}: no guid")
        endif()
        if(_g IN_LIST _guids)
            fail("${_rel}: duplicated ${_g}")
        endif()
        list(APPEND _guids "${_g}")
    elseif(NOT EXISTS "${PKG}/${_rel}.meta")
        fail("missing meta: ${_rel}.meta")
    endif()
endforeach()
message(STATUS "PASS: every asset has a .meta")

# --- Fixtures -----------------------------------------------------------------------------------
set(_native "${ERGO_SOURCE_DIR}/tests/package_watch/fixtures")
set(_unity "${PKG}/Tests/Editor/Fixtures")
file(GLOB _native_files RELATIVE "${_native}" "${_native}/*.json")
file(GLOB _unity_files RELATIVE "${_unity}" "${_unity}/*.json")
list(SORT _native_files)
list(SORT _unity_files)
if(NOT "${_native_files}" STREQUAL "${_unity_files}")
    fail("Fixtures differ in files: native [${_native_files}] unity [${_unity_files}]")
endif()
foreach(_f IN LISTS _native_files)
    file(SHA256 "${_native}/${_f}" _a)
    file(SHA256 "${_unity}/${_f}" _b)
    if(NOT _a STREQUAL _b)
        fail("Fixtures/${_f} is not byte-identical to tests/package_watch/fixtures/${_f}")
    endif()
endforeach()
message(STATUS "PASS: Fixtures are byte-identical")

# --- no absolute path (§8) ----------------------------------------------------------------------
file(GLOB_RECURSE _texts "${PKG}/*.cs" "${PKG}/*.json" "${PKG}/*.md" "${PKG}/*.asmdef")
foreach(_t IN LISTS _texts)
    file(STRINGS "${_t}" _hits REGEX "(^|[^A-Za-z0-9])[A-Za-z]:[\\\\/]|/Users/|/home/")
    if(_hits)
        fail("${_t}: absolute path: ${_hits}")
    endif()
endforeach()
message(STATUS "PASS: no absolute path")
