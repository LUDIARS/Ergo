{
  "name": "build-packages",
  "description": "【AI 案・人の承認前】ビルドとパッケージ取り込み。 パッケージ・ハブのマニフェスト (ergo-packages.json)・cmake/ の取り込み / 検査 / 結線・外部依存 (cmake/deps)・CMake プリセット・取り込みの CMake テスト・tool パッケージの置き場 (lib/ と .gitmodules)。",
  "presetRules": [],
  "templateRules": [],
  "specRefs": [
    "spec/feature/package-hub.md",
    "spec/data/ergo-packages.md",
    "spec/setup/packages.md",
    "spec/setup/third-party-deps.md",
    "spec/architecture/domains-and-ux.md",
    "spec/feature/package-manager.md",
    "spec/module/package_manager.md"
  ],
  "membership": [
    {
      "pathPattern": "(^|/)cmake/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "^ergo-packages\\.json$"
    },
    {
      "pathPattern": "^CMakePresets\\.json$"
    },
    {
      "pathPattern": "(^|/)tests/packages/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)lib/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "^\\.gitmodules$"
    },
    {
      "pathPattern": "(^|/)src/package_manager/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)include/ergo/package_manager/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)tests/package_manager/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)tools/package_cli/(?:.*/)?[^/]+$"
    }
  ]
}
