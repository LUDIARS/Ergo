{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "ide-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "ERGO_BUILD_TESTS": false,
        "ERGO_BUILD_DUMMY": false,
        "ERGO_BUILD_BENCHMARKS": false,
        "ERGO_AUDIO_BACKEND": "dummy",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (x64)",
      "inherits": "ide-base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_C_FLAGS": "/utf-8",
        "CMAKE_CXX_FLAGS": "/utf-8"
      }
    },
    {
      "name": "vs2022-deps",
      "displayName": "Visual Studio 2022 (x64, libcurl)",
      "inherits": "vs2022",
      "cacheVariables": {
        "ERGO_WITH_CURL": true,
        "ERGO_BUILD_HTTP": true
      }
    },
    {
      "name": "ci-packages",
      "displayName": "CI: package hub fetch + STRICT (Pictor / Tela at the manifest pins)",
      "description": "ERGO_PACKAGES=pictor;tela acquired by the hub (ERGO_PACKAGES_FETCH=ON) with every warning-level finding as an error (ERGO_PACKAGES_STRICT=ON). See spec/setup/packages.md.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "ERGO_PACKAGES": "pictor;tela",
        "ERGO_PACKAGES_FETCH": true,
        "ERGO_PACKAGES_STRICT": true,
        "ERGO_BUILD_TESTS": true,
        "ERGO_AUDIO_BACKEND": "dummy"
      }
    },
    {
      "name": "ci-base",
      "hidden": true,
      "description": "Shared base of the Linux CI legs (.github/workflows/ci.yml). See spec/setup/ci.md.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "ERGO_BUILD_TESTS": true,
        "ERGO_AUDIO_BACKEND": "dummy"
      }
    },
    {
      "name": "ci-linux-gcc",
      "displayName": "CI: Linux GCC (Release)",
      "inherits": "ci-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "ci-linux-clang",
      "displayName": "CI: Linux clang (Release, -Wall -Wextra)",
      "inherits": "ci-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra"
      }
    },
    {
      "name": "ci-asan",
      "displayName": "CI: Linux ASan + UBSan (Debug)",
      "inherits": "ci-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "xcode",
      "displayName": "Xcode (macOS, host architecture)",
      "inherits": "ide-base",
      "generator": "Xcode",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "xcode-deps",
      "displayName": "Xcode (macOS, libcurl/OpenSSL)",
      "inherits": "xcode",
      "cacheVariables": {
        "ERGO_WITH_CURL": true,
        "ERGO_BUILD_HTTP": true,
        "CURL_USE_OPENSSL": true
      }
    }
  ],
  "buildPresets": [
    { "name": "vs2022-debug", "configurePreset": "vs2022", "configuration": "Debug" },
    { "name": "vs2022-release", "configurePreset": "vs2022", "configuration": "Release" },
    { "name": "vs2022-deps-debug", "configurePreset": "vs2022-deps", "configuration": "Debug" },
    { "name": "vs2022-deps-release", "configurePreset": "vs2022-deps", "configuration": "Release" },
    { "name": "ci-packages", "configurePreset": "ci-packages", "configuration": "Release" },
    { "name": "ci-linux-gcc", "configurePreset": "ci-linux-gcc" },
    { "name": "ci-linux-clang", "configurePreset": "ci-linux-clang" },
    { "name": "ci-asan", "configurePreset": "ci-asan" },
    { "name": "xcode-debug", "configurePreset": "xcode", "configuration": "Debug" },
    { "name": "xcode-release", "configurePreset": "xcode", "configuration": "Release" },
    { "name": "xcode-deps-debug", "configurePreset": "xcode-deps", "configuration": "Debug" },
    { "name": "xcode-deps-release", "configurePreset": "xcode-deps", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "ci-packages",
      "configurePreset": "ci-packages",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    {
      "name": "ci-linux-gcc",
      "configurePreset": "ci-linux-gcc",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    {
      "name": "ci-linux-clang",
      "configurePreset": "ci-linux-clang",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    {
      "name": "ci-asan",
      "configurePreset": "ci-asan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    }
  ]
}
