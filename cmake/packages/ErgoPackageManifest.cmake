# ---------------------------------------------------------------------------
# ErgoPackageManifest.cmake — read ergo-packages.json into CMake variables
#
# One responsibility: turn the manifest (schema 1, spec/data/ergo-packages.md)
# into flat list variables that the pure rules (ErgoPackageRules.cmake) and
# the report (ErgoPackageReport.cmake) consume. It only reads the given file;
# it creates no targets and sets no cache entries.
#
#   ergo_pkg_manifest_load(<prefix> <file> [HOST])
#
# Without HOST the file must be an Ergo manifest: a file with a top-level
# `host` section is a host declaration (spec/feature/package-manager.md
# §2.1) and stops the configure. With HOST the file is read as a host
# declaration (or a legacy extra manifest without `host`): its `packages`
# are the host's private packages, and <prefix>_HOST_PRESENT /
# <prefix>_HOST_CODE carry the `host` section facts the hub uses, with the
# configure defaults <prefix>_HOST_USE / _HOST_OPTIONAL (lists),
# <prefix>_HOST_FEATURES ("<package>=<token>,<token>" pairs, sorted) and
# Ergo's own pin <prefix>_HOST_ERGO_REV / _HOST_ERGO_EXPECT_TAG and the
# legacy aliases <prefix>_HOST_LEGACY_VARS ("<VAR>=<target>" pairs, sorted).
#
# Sets in the caller's scope (names are sorted):
#   <prefix>_SCHEMA, <prefix>_ERRORS (schema problems, one text per entry)
#   <prefix>_PACKAGES / _LINK / _TOOLS / _MODULES / _OBSERVE
#   <prefix>_DIR (directory of the manifest), <prefix>_VARS (names of every
#   per-entry variable below, for ergo_pkg_manifest_merge)
#   per package  <prefix>_PKG_<n>_{KIND,CODE,REPOSITORY,REPO_NAME,REV,
#                EXPECT_TAG,PLATFORMS,CMAKE_MINIMUM,WIRING,TARGETS,
#                FIND_PACKAGE,REQUIRES,FEATURES,CACHE,EXPORTS,ACQUIRE,PATH,
#                MANIFEST_DIR}
#                (REPO_NAME: last path element of `repository` without .git,
#                 the sibling-checkout directory name; WIRING: absolute path)
#   per feature  <prefix>_PKG_<n>_FEAT_<f>_{DEFAULT,PLATFORMS,RESERVED,
#                PROVIDES,CONTRACT,REQUIRES,CONFLICTS,CACHE}
#   per module   <prefix>_MOD_<m>_{NEEDS,OPTIONAL,NEED_KIND,WHEN,PORTED_FROM,
#                REAL_PATH_VAR,REASON_VAR}
#   per observe  <prefix>_OBS_<o>_{CODE,PATH_HINT,GROUP,RELATIONS}
#                (RELATIONS entries are "<from>:<kind>")
#
#   ergo_pkg_manifest_merge(<prefix> <extra_prefix> <out_findings>)
#
# Adds the entries of a second loaded manifest (ERGO_PACKAGE_MANIFEST_EXTRA)
# to <prefix>. A name already present is not merged and becomes a PKG-15
# error finding (a host extra manifest must not redefine public entries).
# ---------------------------------------------------------------------------
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ErgoPackageRules.cmake")

# Internal: string member at <path...>, or "" when absent / null.
function(_ergo_pkg_json_string out_var json)
    string(JSON _type ERROR_VARIABLE _err TYPE "${json}" ${ARGN})
    if(_err OR _type STREQUAL "NULL")
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    string(JSON _value GET "${json}" ${ARGN})
    set(${out_var} "${_value}" PARENT_SCOPE)
endfunction()

# Internal: array of strings at <path...> as a CMake list ("" when absent).
function(_ergo_pkg_json_array out_var json)
    set(_items "")
    string(JSON _type ERROR_VARIABLE _err TYPE "${json}" ${ARGN})
    if(NOT _err AND _type STREQUAL "ARRAY")
        string(JSON _len LENGTH "${json}" ${ARGN})
        if(_len GREATER 0)
            math(EXPR _last "${_len} - 1")
            foreach(_i RANGE ${_last})
                string(JSON _item GET "${json}" ${ARGN} ${_i})
                list(APPEND _items "${_item}")
            endforeach()
        endif()
    endif()
    set(${out_var} "${_items}" PARENT_SCOPE)
endfunction()

# Internal: sorted member names of the object at <path...> ("" when absent).
function(_ergo_pkg_json_keys out_var json)
    set(_keys "")
    string(JSON _type ERROR_VARIABLE _err TYPE "${json}" ${ARGN})
    if(NOT _err AND _type STREQUAL "OBJECT")
        string(JSON _len LENGTH "${json}" ${ARGN})
        if(_len GREATER 0)
            math(EXPR _last "${_len} - 1")
            foreach(_i RANGE ${_last})
                string(JSON _key MEMBER "${json}" ${ARGN} ${_i})
                list(APPEND _keys "${_key}")
            endforeach()
        endif()
    endif()
    list(SORT _keys)
    set(${out_var} "${_keys}" PARENT_SCOPE)
endfunction()

# Internal: object at <path...> as "<key>=<value>" pairs (sorted by key).
function(_ergo_pkg_json_pairs out_var json)
    _ergo_pkg_json_keys(_keys "${json}" ${ARGN})
    set(_pairs "")
    foreach(_k IN LISTS _keys)
        _ergo_pkg_json_string(_v "${json}" ${ARGN} "${_k}")
        list(APPEND _pairs "${_k}=${_v}")
    endforeach()
    set(${out_var} "${_pairs}" PARENT_SCOPE)
endfunction()

function(ergo_pkg_manifest_load prefix file)
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "ergo packages: manifest '${file}' does not exist")
    endif()
    file(READ "${file}" _json)
    string(JSON _type ERROR_VARIABLE _err TYPE "${_json}")
    if(_err OR NOT _type STREQUAL "OBJECT")
        message(FATAL_ERROR "ergo packages: manifest '${file}' is not a JSON object (${_err})")
    endif()
    string(JSON _host_type ERROR_VARIABLE _host_err TYPE "${_json}" host)
    set(_host_present FALSE)
    if(NOT _host_err)
        set(_host_present TRUE)
    endif()
    if(_host_present AND NOT "HOST" IN_LIST ARGN)
        message(FATAL_ERROR "ergo packages: '${file}' has a `host` section: it is a host "
            "declaration, not an Ergo manifest (spec/data/ergo-packages.md, host declaration)")
    endif()
    set(_host_code "")
    set(_host_use "")
    set(_host_optional "")
    set(_host_features "")
    set(_host_ergo_rev "")
    set(_host_ergo_tag "")
    set(_host_legacy "")
    if(_host_present)
        if(NOT _host_type STREQUAL "OBJECT")
            message(FATAL_ERROR "ergo packages: host declaration '${file}': `host` is not an object")
        endif()
        _ergo_pkg_json_string(_host_code "${_json}" host code)
        _ergo_pkg_json_array(_host_use "${_json}" host use)
        _ergo_pkg_json_array(_host_optional "${_json}" host optional)
        _ergo_pkg_json_keys(_feature_keys "${_json}" host features)
        foreach(_k IN LISTS _feature_keys)
            _ergo_pkg_json_string(_v "${_json}" host features "${_k}")
            string(REPLACE ";" "," _v "${_v}")  # "vulkan;web" stays one list item
            list(APPEND _host_features "${_k}=${_v}")
        endforeach()
        _ergo_pkg_json_string(_host_ergo_rev "${_json}" host ergo rev)
        _ergo_pkg_json_string(_host_ergo_tag "${_json}" host ergo expect_tag)
        _ergo_pkg_json_pairs(_host_legacy "${_json}" host legacy_vars)
    endif()

    set(_out "")       # names of every variable to hand back
    set(_errors "")
    get_filename_component(_dir "${file}" DIRECTORY)

    _ergo_pkg_json_string(_schema "${_json}" schema)
    if(NOT _schema STREQUAL "1")
        list(APPEND _errors "schema is '${_schema}' but this Ergo reads schema 1")
    endif()

    _ergo_pkg_json_keys(_packages "${_json}" packages)
    set(_link "")
    set(_tools "")
    foreach(_n IN LISTS _packages)
        set(_p "${prefix}_PKG_${_n}")
        _ergo_pkg_json_string(${_p}_KIND        "${_json}" packages "${_n}" kind)
        _ergo_pkg_json_string(${_p}_CODE        "${_json}" packages "${_n}" code)
        _ergo_pkg_json_string(${_p}_GROUP       "${_json}" packages "${_n}" group)
        _ergo_pkg_json_string(${_p}_REPOSITORY  "${_json}" packages "${_n}" repository)
        _ergo_pkg_json_string(${_p}_REV         "${_json}" packages "${_n}" rev)
        _ergo_pkg_json_string(${_p}_EXPECT_TAG  "${_json}" packages "${_n}" expect_tag)
        _ergo_pkg_json_array (${_p}_PLATFORMS   "${_json}" packages "${_n}" platforms)
        _ergo_pkg_json_string(${_p}_CMAKE_MINIMUM "${_json}" packages "${_n}" cmake minimum)
        _ergo_pkg_json_string(${_p}_WIRING      "${_json}" packages "${_n}" cmake wiring)
        _ergo_pkg_json_array (${_p}_TARGETS     "${_json}" packages "${_n}" cmake targets)
        _ergo_pkg_json_string(${_p}_FIND_PACKAGE "${_json}" packages "${_n}" cmake find_package name)
        _ergo_pkg_json_pairs (${_p}_CACHE       "${_json}" packages "${_n}" cmake cache)
        _ergo_pkg_json_pairs (${_p}_EXPORTS     "${_json}" packages "${_n}" exports)
        _ergo_pkg_json_keys  (${_p}_REQUIRES    "${_json}" packages "${_n}" requires)
        _ergo_pkg_json_string(${_p}_ACQUIRE     "${_json}" packages "${_n}" acquire)
        _ergo_pkg_json_string(${_p}_PATH        "${_json}" packages "${_n}" path)
        _ergo_pkg_json_keys  (${_p}_FEATURES    "${_json}" packages "${_n}" features)
        if(NOT ${_p}_WIRING STREQUAL "" AND NOT IS_ABSOLUTE "${${_p}_WIRING}")
            set(${_p}_WIRING "${_dir}/${${_p}_WIRING}")
        endif()
        set(${_p}_REPO_NAME "")
        if(${_p}_REPOSITORY MATCHES "([^/:]+)/*$")
            string(REGEX REPLACE "[.]git$" "" ${_p}_REPO_NAME "${CMAKE_MATCH_1}")
        endif()
        set(${_p}_MANIFEST_DIR "${_dir}")
        list(APPEND _out ${_p}_KIND ${_p}_CODE ${_p}_GROUP ${_p}_REPOSITORY ${_p}_REPO_NAME ${_p}_REV
            ${_p}_EXPECT_TAG ${_p}_PLATFORMS ${_p}_CMAKE_MINIMUM ${_p}_WIRING ${_p}_TARGETS
            ${_p}_FIND_PACKAGE ${_p}_CACHE ${_p}_EXPORTS ${_p}_REQUIRES ${_p}_ACQUIRE ${_p}_PATH
            ${_p}_FEATURES ${_p}_MANIFEST_DIR)

        if(${_p}_KIND STREQUAL "link")
            list(APPEND _link "${_n}")
        elseif(${_p}_KIND STREQUAL "tool")
            list(APPEND _tools "${_n}")
        else()
            list(APPEND _errors "package '${_n}' has kind '${${_p}_KIND}' (want link or tool)")
        endif()

        foreach(_f IN LISTS ${_p}_FEATURES)
            set(_q "${_p}_FEAT_${_f}")
            _ergo_pkg_json_string(${_q}_DEFAULT   "${_json}" packages "${_n}" features "${_f}" default)
            _ergo_pkg_json_array (${_q}_PLATFORMS "${_json}" packages "${_n}" features "${_f}" platforms)
            _ergo_pkg_json_string(${_q}_RESERVED  "${_json}" packages "${_n}" features "${_f}" reserved)
            _ergo_pkg_json_array (${_q}_PROVIDES  "${_json}" packages "${_n}" features "${_f}" provides)
            _ergo_pkg_json_string(${_q}_CONTRACT  "${_json}" packages "${_n}" features "${_f}" contract)
            _ergo_pkg_json_array (${_q}_REQUIRES  "${_json}" packages "${_n}" features "${_f}" requires)
            _ergo_pkg_json_array (${_q}_CONFLICTS "${_json}" packages "${_n}" features "${_f}" conflicts)
            _ergo_pkg_json_pairs (${_q}_CACHE     "${_json}" packages "${_n}" features "${_f}" cache)
            if(${_q}_RESERVED STREQUAL "ON")
                set(${_q}_RESERVED TRUE)
            else()
                set(${_q}_RESERVED FALSE)
            endif()
            list(APPEND _out ${_q}_DEFAULT ${_q}_PLATFORMS ${_q}_RESERVED ${_q}_PROVIDES
                ${_q}_CONTRACT ${_q}_REQUIRES ${_q}_CONFLICTS ${_q}_CACHE)
        endforeach()
    endforeach()

    _ergo_pkg_json_keys(_modules "${_json}" modules)
    foreach(_m IN LISTS _modules)
        set(_q "${prefix}_MOD_${_m}")
        _ergo_pkg_json_array (${_q}_NEEDS         "${_json}" modules "${_m}" needs)
        _ergo_pkg_json_array (${_q}_OPTIONAL      "${_json}" modules "${_m}" optional)
        _ergo_pkg_json_string(${_q}_NEED_KIND     "${_json}" modules "${_m}" need_kind)
        _ergo_pkg_json_string(${_q}_WHEN          "${_json}" modules "${_m}" when)
        _ergo_pkg_json_string(${_q}_REAL_PATH_VAR "${_json}" modules "${_m}" real_path_var)
        _ergo_pkg_json_string(${_q}_REASON_VAR    "${_json}" modules "${_m}" reason_var)
        set(${_q}_PORTED_FROM "")
        string(JSON _type ERROR_VARIABLE _err TYPE "${_json}" modules "${_m}" ported_from)
        if(NOT _err AND _type STREQUAL "ARRAY")
            string(JSON _len LENGTH "${_json}" modules "${_m}" ported_from)
            if(_len GREATER 0)
                math(EXPR _last "${_len} - 1")
                foreach(_i RANGE ${_last})
                    _ergo_pkg_json_string(_from "${_json}" modules "${_m}" ported_from ${_i} package)
                    list(APPEND ${_q}_PORTED_FROM "${_from}")
                endforeach()
            endif()
        endif()
        list(APPEND _out ${_q}_NEEDS ${_q}_OPTIONAL ${_q}_NEED_KIND ${_q}_WHEN
            ${_q}_REAL_PATH_VAR ${_q}_REASON_VAR ${_q}_PORTED_FROM)
    endforeach()

    _ergo_pkg_json_keys(_observe "${_json}" observe)
    foreach(_o IN LISTS _observe)
        set(_q "${prefix}_OBS_${_o}")
        _ergo_pkg_json_string(${_q}_CODE      "${_json}" observe "${_o}" code)
        _ergo_pkg_json_string(${_q}_PATH_HINT "${_json}" observe "${_o}" path_hint)
        _ergo_pkg_json_string(${_q}_GROUP     "${_json}" observe "${_o}" group)
        set(${_q}_RELATIONS "")
        string(JSON _type ERROR_VARIABLE _err TYPE "${_json}" observe "${_o}" relations)
        if(NOT _err AND _type STREQUAL "ARRAY")
            string(JSON _len LENGTH "${_json}" observe "${_o}" relations)
            if(_len GREATER 0)
                math(EXPR _last "${_len} - 1")
                foreach(_i RANGE ${_last})
                    _ergo_pkg_json_string(_from "${_json}" observe "${_o}" relations ${_i} from)
                    _ergo_pkg_json_string(_kind "${_json}" observe "${_o}" relations ${_i} kind)
                    list(APPEND ${_q}_RELATIONS "${_from}:${_kind}")
                endforeach()
            endif()
        endif()
        list(APPEND _out ${_q}_CODE ${_q}_PATH_HINT ${_q}_GROUP ${_q}_RELATIONS)
    endforeach()

    set(${prefix}_SCHEMA   "${_schema}"   PARENT_SCOPE)
    set(${prefix}_ERRORS   "${_errors}"   PARENT_SCOPE)
    set(${prefix}_PACKAGES "${_packages}" PARENT_SCOPE)
    set(${prefix}_LINK     "${_link}"     PARENT_SCOPE)
    set(${prefix}_TOOLS    "${_tools}"    PARENT_SCOPE)
    set(${prefix}_MODULES  "${_modules}"  PARENT_SCOPE)
    set(${prefix}_OBSERVE  "${_observe}"  PARENT_SCOPE)
    set(${prefix}_DIR      "${_dir}"      PARENT_SCOPE)
    set(${prefix}_HOST_PRESENT "${_host_present}" PARENT_SCOPE)
    set(${prefix}_HOST_CODE    "${_host_code}"    PARENT_SCOPE)
    set(${prefix}_HOST_USE      "${_host_use}"      PARENT_SCOPE)
    set(${prefix}_HOST_OPTIONAL "${_host_optional}" PARENT_SCOPE)
    set(${prefix}_HOST_FEATURES "${_host_features}" PARENT_SCOPE)
    set(${prefix}_HOST_ERGO_REV        "${_host_ergo_rev}" PARENT_SCOPE)
    set(${prefix}_HOST_ERGO_EXPECT_TAG "${_host_ergo_tag}" PARENT_SCOPE)
    set(${prefix}_HOST_LEGACY_VARS     "${_host_legacy}"   PARENT_SCOPE)
    set(${prefix}_VARS     "${_out}"      PARENT_SCOPE)
    foreach(_v IN LISTS _out)
        set(${_v} "${${_v}}" PARENT_SCOPE)
    endforeach()
endfunction()

# Internal: does variable name <var> belong to entry <name> of <section>
# (PKG / MOD / OBS) under <prefix>?
function(_ergo_pkg_manifest_owns out_var var prefix section name)
    string(LENGTH "${prefix}_${section}_${name}_" _len)
    string(SUBSTRING "${var}" 0 ${_len} _head)
    if(_head STREQUAL "${prefix}_${section}_${name}_")
        set(${out_var} TRUE PARENT_SCOPE)
    else()
        set(${out_var} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(ergo_pkg_manifest_merge prefix extra out_findings)
    set(_findings "")
    set(_base_names ${${prefix}_PACKAGES} ${${prefix}_MODULES} ${${prefix}_OBSERVE})
    set(_extra_names ${${extra}_PACKAGES} ${${extra}_MODULES} ${${extra}_OBSERVE})
    ergo_pkg_rule_collisions(_findings BASE_NAMES ${_base_names} EXTRA_NAMES ${_extra_names})

    set(_vars ${${prefix}_VARS})
    foreach(_e IN LISTS ${extra}_ERRORS)
        list(APPEND ${prefix}_ERRORS "extra manifest: ${_e}")
    endforeach()
    foreach(_pair PKG:PACKAGES MOD:MODULES OBS:OBSERVE)
        string(REPLACE ":" ";" _pair "${_pair}")
        list(GET _pair 0 _section)
        list(GET _pair 1 _list)
        foreach(_n IN LISTS ${extra}_${_list})
            if(_n IN_LIST _base_names)
                continue()
            endif()
            list(APPEND ${prefix}_${_list} "${_n}")
            if(_section STREQUAL "PKG")
                if(${extra}_PKG_${_n}_KIND STREQUAL "link")
                    list(APPEND ${prefix}_LINK "${_n}")
                elseif(${extra}_PKG_${_n}_KIND STREQUAL "tool")
                    list(APPEND ${prefix}_TOOLS "${_n}")
                endif()
            endif()
            foreach(_v IN LISTS ${extra}_VARS)
                _ergo_pkg_manifest_owns(_mine "${_v}" "${extra}" "${_section}" "${_n}")
                if(_mine)
                    string(LENGTH "${extra}" _plen)
                    string(SUBSTRING "${_v}" ${_plen} -1 _tail)
                    set(${prefix}${_tail} "${${_v}}" PARENT_SCOPE)
                    list(APPEND _vars "${prefix}${_tail}")
                endif()
            endforeach()
        endforeach()
        list(SORT ${prefix}_${_list})
        set(${prefix}_${_list} "${${prefix}_${_list}}" PARENT_SCOPE)
    endforeach()
    list(SORT ${prefix}_LINK)
    list(SORT ${prefix}_TOOLS)
    set(${prefix}_LINK   "${${prefix}_LINK}"   PARENT_SCOPE)
    set(${prefix}_TOOLS  "${${prefix}_TOOLS}"  PARENT_SCOPE)
    set(${prefix}_ERRORS "${${prefix}_ERRORS}" PARENT_SCOPE)
    set(${prefix}_VARS   "${_vars}"            PARENT_SCOPE)
    set(${out_findings}  "${_findings}"        PARENT_SCOPE)
endfunction()
