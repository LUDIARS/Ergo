# ergo-bootstrap.cmake — written by `ergo_pkg init`; do not edit (rerun init to refresh).
# ergo-bootstrap-source: @ERGO_BOOTSTRAP_SOURCE@
# Finds Ergo for this host and add_subdirectory()s it, in this order
# (Ergo spec/feature/package-manager.md §2.1):
#   1. ERGO_SOURCE_DIR (or a host.legacy_vars alias of "ergo.source_dir")
#   2. the sibling checkout <host>/../<Repo> (Repo = last part of host.ergo.repository)
#   3. host.ergo.repository at host.ergo.rev, only with ERGO_BOOTSTRAP_FETCH=ON (network)
# Afterwards ERGO_BOOTSTRAP_ROUTE is source / sibling / fetch and ERGO_BOOTSTRAP_DIR the checkout.
include_guard(GLOBAL)
get_filename_component(_ergo_bs_host "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(READ "${_ergo_bs_host}/ergo-packages.json" _ergo_bs_json)
string(JSON _ergo_bs_repo ERROR_VARIABLE _ergo_bs_err GET "${_ergo_bs_json}" host ergo repository)
string(JSON _ergo_bs_rev ERROR_VARIABLE _ergo_bs_err GET "${_ergo_bs_json}" host ergo rev)
set(ERGO_SOURCE_DIR "" CACHE PATH "Ergo checkout (empty = sibling, then fetch with ERGO_BOOTSTRAP_FETCH)")
option(ERGO_BOOTSTRAP_FETCH "Fetch Ergo at host.ergo.rev when no checkout is found (network)" OFF)
string(JSON _ergo_bs_n ERROR_VARIABLE _ergo_bs_err LENGTH "${_ergo_bs_json}" host legacy_vars)
if(NOT _ergo_bs_err AND _ergo_bs_n GREATER 0 AND "${ERGO_SOURCE_DIR}" STREQUAL "")
    math(EXPR _ergo_bs_last "${_ergo_bs_n} - 1")
    foreach(_ergo_bs_i RANGE ${_ergo_bs_last})
        string(JSON _ergo_bs_var MEMBER "${_ergo_bs_json}" host legacy_vars ${_ergo_bs_i})
        string(JSON _ergo_bs_to GET "${_ergo_bs_json}" host legacy_vars "${_ergo_bs_var}")
        if(_ergo_bs_to STREQUAL "ergo.source_dir" AND NOT "${${_ergo_bs_var}}" STREQUAL "")
            message(DEPRECATION "${_ergo_bs_var} is a legacy alias: set ERGO_SOURCE_DIR instead")
            set(ERGO_SOURCE_DIR "${${_ergo_bs_var}}")
        endif()
    endforeach()
endif()
string(REGEX REPLACE "^.*[/:]([^/:]+)/*$" "\\1" _ergo_bs_name "${_ergo_bs_repo}")
string(REGEX REPLACE "[.]git$" "" _ergo_bs_name "${_ergo_bs_name}")
get_filename_component(_ergo_bs_sibling "${_ergo_bs_host}/../${_ergo_bs_name}" ABSOLUTE)
if(NOT "${ERGO_SOURCE_DIR}" STREQUAL "")
    get_filename_component(ERGO_BOOTSTRAP_DIR "${ERGO_SOURCE_DIR}" ABSOLUTE)
    set(ERGO_BOOTSTRAP_ROUTE source)
    if(NOT EXISTS "${ERGO_BOOTSTRAP_DIR}/CMakeLists.txt")
        message(FATAL_ERROR "ERGO_SOURCE_DIR '${ERGO_SOURCE_DIR}' is not an Ergo checkout")
    endif()
elseif(NOT _ergo_bs_name STREQUAL "" AND EXISTS "${_ergo_bs_sibling}/CMakeLists.txt")
    set(ERGO_BOOTSTRAP_DIR "${_ergo_bs_sibling}")
    set(ERGO_BOOTSTRAP_ROUTE sibling)
elseif(ERGO_BOOTSTRAP_FETCH)
    if(NOT _ergo_bs_rev MATCHES "^[0-9a-f]+$" OR NOT _ergo_bs_rev MATCHES "^........................................$")
        message(FATAL_ERROR "PKG-02 ergo: host.ergo.rev '${_ergo_bs_rev}' is not a 40-digit commit SHA")
    endif()
    include(FetchContent)
    # Full history: the pin is a SHA, and a shallow clone only reaches branch / tag tips.
    FetchContent_Declare(ergo GIT_REPOSITORY "${_ergo_bs_repo}" GIT_TAG "${_ergo_bs_rev}"
        GIT_SHALLOW FALSE SOURCE_SUBDIR _ergo_no_build)
    FetchContent_MakeAvailable(ergo)
    set(ERGO_BOOTSTRAP_DIR "${ergo_SOURCE_DIR}")
    set(ERGO_BOOTSTRAP_ROUTE fetch)
else()
    message(FATAL_ERROR "Ergo not found: set ERGO_SOURCE_DIR, check out ${_ergo_bs_name} next to "
        "this host, or allow fetching with -DERGO_BOOTSTRAP_FETCH=ON")
endif()
add_subdirectory("${ERGO_BOOTSTRAP_DIR}" "${CMAKE_BINARY_DIR}/_ergo")
