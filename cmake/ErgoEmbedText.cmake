# ergo_embed_text(<target> <symbol> <input-file>)
#
# Compile <input-file> into <target> as
#   extern const char        <symbol>[];      // NUL-terminated
#   extern const std::size_t <symbol>_size;   // without the NUL
# so data files (preset catalogs) ship inside the binary instead of being
# looked up next to the executable at run time. The source is generated at
# configure time; editing <input-file> re-runs configure.
function(ergo_embed_text target symbol input)
    get_filename_component(abs "${input}" ABSOLUTE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${abs}")
    file(READ "${abs}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    # Character literals ('\xNN'), not integers: bytes above 0x7F would be a
    # narrowing conversion into char.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," bytes "${hex}")
    # Break the initializer into lines so compilers do not choke on one huge line.
    string(REGEX REPLACE "(('\\\\x[0-9a-f][0-9a-f]',){32})" "\\1\n" bytes "${bytes}")
    set(out "${CMAKE_CURRENT_BINARY_DIR}/embed/${symbol}.cpp")
    file(WRITE "${out}.tmp"
        "// Generated by ergo_embed_text from ${abs}. Do not edit.\n"
        "#include <cstddef>\n"
        "extern const char ${symbol}[];\n"
        "extern const std::size_t ${symbol}_size;\n"
        "const char ${symbol}[] = {\n${bytes}'\\0'};\n"
        "const std::size_t ${symbol}_size = ${size};\n")
    # Only touch the real file when it changed, to avoid needless rebuilds.
    configure_file("${out}.tmp" "${out}" COPYONLY)
    target_sources(${target} PRIVATE "${out}")
endfunction()
